{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:REPLACE_ACCOUNT_ID:instance/REPLACE_INSTANCE_ID"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:ResumeSession",
        "ssm:TerminateSession"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:REPLACE_ACCOUNT_ID:session/REPLACE_APPROVED_SESSION_PREFIX-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-StartSSHSession"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetConnectionStatus"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:REPLACE_ACCOUNT_ID:instance/REPLACE_INSTANCE_ID"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetDocument",
        "ssm:DescribeDocument"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-StartSSHSession"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:REPLACE_ACCOUNT_ID:session/REPLACE_APPROVED_SESSION_PREFIX-*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:REPLACE_ACCOUNT_ID:document/SSM-SessionManagerRunShell"
      ]
    }
  ]
}
