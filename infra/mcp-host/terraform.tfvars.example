aws_region = "ap-northeast-2"
vpc_id     = "vpc-REPLACE"
subnet_id  = "subnet-REPLACE"
# 이름 hc-base-* / hc-security-base-* 및 AL2023 x86_64 호환성을 확인한 단일 ID
ami_id     = "ami-REPLACE"
